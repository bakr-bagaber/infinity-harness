{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature List",
  "type": "object",
  "required": [
    "version",
    "features"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "passes",
          "tasks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "passes": {
            "type": "boolean"
          },
          "definitionOfDone": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "producedByRole": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "planner",
              "generator",
              "evaluator",
              "simplifier"
            ],
            "default": null
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "description",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "complete",
                    "blocked"
                  ]
                },
                "acceptanceCriteria": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "producedByRole": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    null,
                    "planner",
                    "generator",
                    "evaluator",
                    "simplifier"
                  ],
                  "default": null
                }
              }
            }
          }
        }
      }
    }
  }
}
